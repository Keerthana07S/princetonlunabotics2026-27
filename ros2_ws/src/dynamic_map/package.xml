<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dynamic_map</name>
  <version>0.1.0</version>
  <description>Dynamic voxel map and LiDAR odometry. Not a full SLAM system.</description>
  <maintainer email="lunabotics@princeton.edu">Princeton Lunabotics</maintainer>
  <license>BSD-3-Clause</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2_ros</depend>
  <exec_depend>lidar_interface</exec_depend>
  <exec_depend>pointcloud_processing</exec_depend>
  <exec_depend>mapping_visualizer</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
