<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pointcloud_processing</name>
  <version>0.1.0</version>
  <description>Preprocessing, geometric features, CLIPPER association, and rigid registration.</description>
  <maintainer email="lunabotics@princeton.edu">Princeton Lunabotics</maintainer>
  <license>BSD-3-Clause</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <exec_depend>lidar_interface</exec_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
